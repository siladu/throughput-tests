{
  "label": "--cache-last-blocks=2048",
  "image": "spamoor:v1.2.4",
  "namespace": "besu-consensus",
  "validatorPod": "besu-node-validator-1-0",
  "rpcUrl": "http://besu-node-rpc-1-0.besu-node-rpc-1.besu-consensus.svc.cluster.local:8545",
  "scenario": "erc20tx",
  "slotDuration": "2s",
  "resetNetwork": true,
  "warmupSeconds": 60,
  "healthTimeoutSeconds": 300,
  "maxFixups": 2,
  "cooldownSeconds": 60,
  "sampleSeconds": 30,
  "runs": [
    { "durationMinutes": 5, "throughput": 12000, "amount": 1, "extraArgs": ["--max-pending", "60000", "--max-wallets", "100"] },
    { "durationMinutes": 5, "throughput": 14000, "amount": 1, "extraArgs": ["--max-pending", "60000", "--max-wallets", "100"] },
    { "durationMinutes": 5, "throughput": 12000, "amount": 1, "extraArgs": ["--max-pending", "80000", "--max-wallets", "100"] },
    { "durationMinutes": 5, "throughput": 10000, "amount": 1, "extraArgs": ["--max-pending", "60000", "--max-wallets", "100"] },
    { "durationMinutes": 5, "throughput": 12000, "amount": 1, "extraArgs": ["--max-pending", "60000", "--max-wallets", "100"] }
  ]
}
